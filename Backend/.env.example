
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Base64-encoded key, at least 32 bytes decoded. Reuse the Spring app's value so
# existing login cookies keep working. Generate one with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=

# Optional
# MONGODB_DATABASE=test          # used only when MONGODB_URI names no database (Spring's default is "test")
# CORS_ALLOWED_ORIGINS=http://localhost:5500   # comma-separated
# PORT=8080
